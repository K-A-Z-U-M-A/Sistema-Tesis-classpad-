// Configuración de OpenCode para ClassPad.
// Documentación: https://opencode.ai/v2/docs/permissions
//
// Reglas en orden; GANA LA ÚLTIMA COINCIDENCIA. Por defecto OpenCode arranca con
// "*" → "allow", así que estas reglas solo necesitan declarar lo que se restringe.
{
  "$schema": "https://opencode.ai/config.json",

  "permissions": [
    // ── Credenciales ────────────────────────────────────────────────────────
    // Los .env reales no se leen ni se escriben. El allow de .env.example va
    // DESPUÉS para que la plantilla siga siendo consultable.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    // ── Datos de personas (estudio de usabilidad) ───────────────────────────
    { "action": "read", "resource": "*credenciales_moderador.csv", "effect": "deny" },
    { "action": "read", "resource": "*participantes_reales.csv", "effect": "deny" },
    { "action": "read", "resource": "*observaciones_reales.csv", "effect": "deny" },
    { "action": "read", "resource": "*sus_responses_reales.csv", "effect": "deny" },
    { "action": "read", "resource": "*entrevista_final_reales.csv", "effect": "deny" },
    { "action": "read", "resource": "*.env.usabilidad", "effect": "deny" },

    // ── Dependencias y carpetas autogeneradas ───────────────────────────────
    // Patrones con barra a ambos lados: un "*dist*" suelto capturaría
    // ficheros legítimos como resumen_estadistico.csv.
    { "action": "read", "resource": "node_modules/*", "effect": "deny" },
    { "action": "read", "resource": "*/node_modules/*", "effect": "deny" },
    { "action": "read", "resource": "dist/*", "effect": "deny" },
    { "action": "read", "resource": "*/dist/*", "effect": "deny" },
    { "action": "read", "resource": "*/test-results/*", "effect": "deny" },
    { "action": "read", "resource": "*/playwright-report/*", "effect": "deny" },

    // ── Git: inspección libre, lo destructivo pregunta ──────────────────────
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git remote *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },

    // ── Borrado de ficheros ─────────────────────────────────────────────────
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "ask" },

    // ── Instalación de dependencias ────────────────────────────────────────
    { "action": "shell", "resource": "npm install *", "effect": "ask" },
    { "action": "shell", "resource": "npm ci *", "effect": "ask" }
  ],

  // Evita que el watcher dispare eventos por carpetas que nunca vamos a mirar.
  "watcher": {
    "ignore": ["**/node_modules/**", "**/dist/**", "**/test-results/**"]
  }
}
